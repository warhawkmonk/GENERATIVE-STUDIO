   "source": [
    "import requests\n",
    "\n",
    "API_URL = \"http://127.0.0.1:8080/generate-text\"\n",
    "\n",
    "prompt = \"Write a short and helpful response about AI tools for developers.\"\n",
    "response = requests.post(API_URL, json={\"prompt\": prompt}, timeout=60)\n",
    "\n",
    "print(response.status_code)\n",
    "print(response.json())\n"
